<mxfile host="Electron">
  <diagram name="Memoria SD v2" id="memoria-sd-v2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Client side ===== -->
        <mxCell id="client" parent="1" style="ellipse;whiteSpace=wrap;html=1;" value="React Client" vertex="1">
          <mxGeometry x="40" y="300" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="clerk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" value="Clerk&lt;br&gt;(external auth service)" vertex="1">
          <mxGeometry x="50" y="120" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="server" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;" value="Node.js + Express Server" vertex="1">
          <mxGeometry x="40" y="480" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Object storage (was TBD) ===== -->
        <mxCell id="storage" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;" value="Object Storage&lt;br&gt;(Cloudinary / S3)&lt;br&gt;photo files" vertex="1">
          <mxGeometry x="490" y="15" width="120" height="95" as="geometry" />
        </mxCell>

        <!-- ===== Server container ===== -->
        <mxCell id="container" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry x="240" y="140" width="620" height="600" as="geometry" />
        </mxCell>
        <mxCell id="header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Modules" vertex="1">
          <mxGeometry x="270" y="155" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="middleware" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" value="Auth middleware (Clerk requireAuth): verify token → req.auth.userId. Runs before EVERY route." vertex="1">
          <mxGeometry x="260" y="205" width="580" height="45" as="geometry" />
        </mxCell>

        <!-- Modules row -->
        <mxCell id="memMod" parent="1" style="whiteSpace=wrap;html=1;" value="Memories API&lt;br&gt;POST / PATCH / DELETE /memories" vertex="1">
          <mxGeometry x="270" y="275" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="upMod" parent="1" style="whiteSpace=wrap;html=1;" value="Upload Service&lt;br&gt;POST /uploads/sign" vertex="1">
          <mxGeometry x="460" y="275" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="readMod" parent="1" style="whiteSpace=wrap;html=1;" value="Read API&lt;br&gt;GET /memories (timeline)&lt;br&gt;GET /memories/map (globe)" vertex="1">
          <mxGeometry x="650" y="275" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- Create pipeline row -->
        <mxCell id="p1" parent="1" style="whiteSpace=wrap;html=1;" value="Upload Picture convert to metadata&lt;br&gt;(EXIF: date + GPS)" vertex="1">
          <mxGeometry x="270" y="390" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="whiteSpace=wrap;html=1;" value="Reverse geocode GPS → place name&lt;br&gt;(no GPS? user drops a pin)" vertex="1">
          <mxGeometry x="400" y="390" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.delay;whiteSpace=wrap;" value="Save Memory to user ID from Clerk&lt;br&gt;(captionStatus: pending)" vertex="1">
          <mxGeometry x="550" y="395" width="125" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;" value="Generate Caption from image + metadata&lt;br&gt;(async job)" vertex="1">
          <mxGeometry x="710" y="390" width="110" height="80" as="geometry" />
        </mxCell>

        <!-- Notes path -->
        <mxCell id="note" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" value="If Client only adds a simple note: skip metadata steps" vertex="1">
          <mxGeometry x="270" y="530" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- ===== External services + DB ===== -->
        <mxCell id="geo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" value="Geocoding API&lt;br&gt;(Mapbox / Nominatim)" vertex="1">
          <mxGeometry x="400" y="790" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mongo" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" value="MongoDB&lt;br&gt;memories collection" vertex="1">
          <mxGeometry x="560" y="780" width="110" height="95" as="geometry" />
        </mxCell>
        <mxCell id="vision" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" value="Vision AI model&lt;br&gt;(Claude / GPT)" vertex="1">
          <mxGeometry x="740" y="790" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="idxNote" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;" value="Indexes:&lt;br&gt;{ userId: 1, takenAt: -1 } → timeline&lt;br&gt;location: 2dsphere → globe&lt;br&gt;(GeoJSON = [lng, lat])" vertex="1">
          <mxGeometry x="890" y="780" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="e1" edge="1" parent="1" source="client" target="clerk" style="endArrow=classic;html=1;rounded=0;" value="1. sign in → session token">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="client" target="server" style="endArrow=classic;html=1;rounded=0;" value="2. API calls + Bearer token">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="server" target="container" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.633;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="clerk" target="middleware" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="verify JWT">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="160" />
              <mxPoint x="220" y="227" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="client" target="storage" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="4. upload photo directly">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="190" y="340" />
              <mxPoint x="190" y="62" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="middleware" target="memMod" style="endArrow=classic;html=1;rounded=0;exitX=0.155;exitY=1;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="middleware" target="upMod" style="endArrow=classic;html=1;rounded=0;exitX=0.483;exitY=1;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="middleware" target="readMod" style="endArrow=classic;html=1;rounded=0;exitX=0.81;exitY=1;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="upMod" target="storage" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" value="3. presigned URL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="memMod" target="p1" style="endArrow=classic;html=1;rounded=0;exitX=0.3;exitY=1;" value="5. create w/ photo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="p1" target="p2" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="p2" target="p3" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="p3" target="p4" style="endArrow=classic;html=1;rounded=0;" value="then">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="memMod" target="note" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="255" y="310" />
              <mxPoint x="255" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="note" target="p3" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" value="save directly">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="581" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="p2" target="geo" style="endArrow=classic;startArrow=classic;html=1;rounded=0;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="p3" target="mongo" style="endArrow=classic;html=1;rounded=0;exitX=0.6;exitY=1;entryX=0.4;entryY=0;" value="insert">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="625" y="680" />
              <mxPoint x="604" y="680" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="p4" target="vision" style="endArrow=classic;startArrow=classic;html=1;rounded=0;dashed=1;exitX=0.7;exitY=1;entryX=0.4;entryY=0;" value="image + date + place">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="787" y="700" />
              <mxPoint x="788" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="p4" target="mongo" style="endArrow=classic;html=1;rounded=0;exitX=0.2;exitY=1;entryX=0.85;entryY=0;" value="update caption">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="732" y="630" />
              <mxPoint x="653" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e20" edge="1" parent="1" source="readMod" target="mongo" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" value="query by userId + date / location">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="845" y="310" />
              <mxPoint x="845" y="760" />
              <mxPoint x="700" y="760" />
              <mxPoint x="700" y="828" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
